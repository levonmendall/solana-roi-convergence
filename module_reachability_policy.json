{
  "policy_version": "v51-module-reachability-130-v5-non-authoritative-service-roots",
  "production_root": "solana_roi.production",
  "non_authoritative_service_roots": [
    "solana_roi.certifier_service",
    "solana_roi.certifier_job"
  ],
  "test_only": [
    "solana_roi.v51_lane_capability_e2e",
    "solana_roi.v51_seeded_e2e",
    "solana_roi.v51_synthetic_provenance",
    "solana_roi.v52_candidate_continuity",
    "solana_roi.v52_continuation_capture",
    "solana_roi.v52_lossless_candidate_accounting",
    "solana_roi.v52_five_lane_e2e_isolation",
    "solana_roi.v52_upside_capture",
    "solana_roi.v52_detection_intelligence",
    "solana_roi.v52_measurement_governance",
    "solana_roi.v52_final_refinement"
  ],
  "migration_only": [
    "solana_roi.cli",
    "solana_roi.split_webhooks",
    "solana_roi.v51_architecture_retirement"
  ],
  "archived_fixture_roots": [
    "docs/archive"
  ],
  "rules": {
    "tests_do_not_grant_production_reachability": true,
    "migration_only_is_never_production_authority": true,
