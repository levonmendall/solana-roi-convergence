# Solana ROI Convergence v5.1 environment example
# Paper-only. Never add a private key, seed phrase, mnemonic, signer, or submission credential.

# -----------------------------------------------------------------------------
# REQUIRED PRODUCTION
# -----------------------------------------------------------------------------
PAPER_ONLY=true
SOLANA_NETWORK=mainnet-beta
SOLANA_ROI_DIRECT_SOLANA_ENABLED=true
SOLANA_ROI_PROGRAM_WIDE_SWAP_COVERAGE=true
SOLANA_ROI_SHADOW_CLOCK_ENABLED=true

# Render production must override this with /var/data/solana-roi.sqlite3.
SOLANA_ROI_DB_PATH=data/solana-roi.sqlite3

# Canonical Solana provider topology: two independent public read-only providers
# plus the Alchemy credential below, which appends a third independent mainnet
# HTTP/WebSocket observer. This mirrors the production quorum model; do not replace
# it with a single-provider local shortcut.
SOLANA_ROI_RPC_ENDPOINTS_JSON=[{"name":"publicnode","http":"https://solana-rpc.publicnode.com","ws":"wss://solana-rpc.publicnode.com"},{"name":"onfinality","http":"https://solana.api.onfinality.io/public","ws":"wss://solana.api.onfinality.io/public-ws"}]
SOLANA_ROI_ALCHEMY_API_KEY=

JUPITER_API_KEY=
SOLANA_ROI_COHORT_ARM_AUTH=
# Public Solana address only; used to assemble/simulate unsigned paper transactions.
SOLANA_ROI_SHADOW_WALLET_PUBLIC_KEY=

# Historical public scout profiles are still required for baseline/audit-compatible
# ingestion, but they are NOT current v5.1 strategy authority.
SOLANA_ROI_WALLET_PROFILES_JSON=[{"wallet":"4BdKaxN8G6ka4GYtQQWk4G4dZRUTX2vQH9GcXdBREFUk","entity_id":"kol:jijo","tier":"S","first_touch_sample_size":191,"historically_eligible":true},{"wallet":"862TYSvRYoiHAK3F3WwTRYAfuGiQaGdxedN9AGvRGWo2","entity_id":"kol:wugi","tier":"S","first_touch_sample_size":52,"historically_eligible":true},{"wallet":"DYAn4XpAkN5mhiXkRB7dGq4Jadnx6XYgu8L5b3WGhbrt","entity_id":"kol:the-doc","tier":"S","first_touch_sample_size":121,"historically_eligible":true}]

# Robinhood Chain decision-authoritative paper evaluation requires a production
# provider HTTP RPC + WebSocket pair for Robinhood Mainnet (chain id 4663).
# The public Robinhood RPC/sequencer are research-observation-only.
ROBINHOOD_CHAIN_ENABLED=true
ROBINHOOD_RPC_URL=
ROBINHOOD_WS_URL=
ROBINHOOD_RWA_FILTER_REQUIRED=true
ROBINHOOD_ENTITY_RESOLUTION_REQUIRED=true

# Render injects RENDER_GIT_COMMIT automatically. SOLANA_ROI_RELEASE_COMMIT is only
# for non-Render exact-release verification and should match the deployed SHA.
SOLANA_ROI_RELEASE_COMMIT=

# -----------------------------------------------------------------------------
# OPTIONAL PRODUCTION TUNING
# Defaults below preserve the current production architecture; changing them is an
# operational change and must not be used to weaken v5.1 economic gates.
# -----------------------------------------------------------------------------
SOLANA_ROI_RPC_TIMEOUT_SECONDS=2.5
SOLANA_ROI_RPC_HEDGE_DELAY_SECONDS=0.15
SOLANA_ROI_DIRECT_HYDRATION_WORKERS=12
SOLANA_ROI_DIRECT_MARKET_SAMPLE_MODULUS=20
SOLANA_ROI_DIRECT_AUDIT_SAMPLE_MODULUS=200
SOLANA_ROI_DIRECT_CONTEXT_DEADLINE_SECONDS=3.0
SOLANA_ROI_DIRECT_CONTEXT_MAX_SIGNATURES=600
SOLANA_ROI_DIRECT_GAP_BACKFILL_MAX_PAGES=5
SOLANA_ROI_DIRECT_RAW_RETENTION_SECONDS=900
SOLANA_ROI_SHADOW_CLOCK_SECONDS=1.0
SOLANA_ROI_PRICE_TRACKING_HORIZON_SECONDS=300
SOLANA_ROI_SYSTEM_PROOF_CACHE_SECONDS=15

ROBINHOOD_RPC_TIMEOUT_SECONDS=4.0
ROBINHOOD_PAPER_STARTING_NAV_USD=500
# Read-only eth_call recipient for Pons v2 tax evaluation; no key exists for it.
ROBINHOOD_PAPER_RECIPIENT_ADDRESS=0x000000000000000000000000000000000000dead
ROBINHOOD_RWA_TOKEN_ADDRESSES_JSON=[]

# -----------------------------------------------------------------------------
# RESEARCH ONLY
# -----------------------------------------------------------------------------
# Optional deterministic ETH/USD override for tests/research. Leave blank in production.
ROBINHOOD_ETH_USD_FIXED=

# -----------------------------------------------------------------------------
# LEGACY / ARCHIVE
# -----------------------------------------------------------------------------
# Legacy Helius-worker and Robinhood historical-catch-up variables are intentionally
# not exposed here. They have no current production readiness or economic authority.
# Historical values remain recoverable from Git history and archived documentation.
