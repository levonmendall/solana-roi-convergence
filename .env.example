PAPER_ONLY=true
SOLANA_NETWORK=mainnet-beta
HELIUS_API_KEY=
HELIUS_WEBHOOK_AUTH=
JUPITER_API_KEY=
SOLANA_ROI_DB_PATH=data/solana-roi.sqlite3
SOLANA_ROI_WALLET_PROFILES_JSON=[]
# Set true only after the Helius webhook/stream is configured to cover every supported launch/swap program from pool creation onward.
SOLANA_ROI_PROGRAM_WIDE_SWAP_COVERAGE=false
# Shadow-only periodic WSOL-denominated marks. Does not enable paper positions.
SOLANA_ROI_SHADOW_CLOCK_ENABLED=false
SOLANA_ROI_SHADOW_CLOCK_SECONDS=1.0
SOLANA_ROI_PRICE_TRACKING_HORIZON_SECONDS=300
