PAPER_ONLY=true
SOLANA_NETWORK=mainnet-beta
HELIUS_API_KEY=
HELIUS_WEBHOOK_AUTH=
JUPITER_API_KEY=
SOLANA_ROI_DB_PATH=data/solana-roi.sqlite3
SOLANA_ROI_WALLET_PROFILES_JSON=[]
# Exact deployed Git commit bound into the frozen v3.1 cohort manifest.
SOLANA_ROI_RELEASE_COMMIT=
# Separate administrative bearer secret required by the freeze/arm endpoints.
SOLANA_ROI_COHORT_ARM_AUTH=
# Dedicated mainnet Solana public address used only to assemble and simulate the
# exact taker transaction. Never provide a private key to this application.
SOLANA_ROI_SHADOW_WALLET_PUBLIC_KEY=
# This only configures program-wide collection. It does NOT prove coverage; the
# forward gate still requires 100+ prospective launch/funding observations plus
# empirical normalized swap delivery from every frozen supported program source.
SOLANA_ROI_PROGRAM_WIDE_SWAP_COVERAGE=false
# Continuous WSOL-denominated marks. Must be enabled before the forward cohort is armed
# so confirmation timeout, stop, stagnation, harvest, and runner-trail exits advance.
SOLANA_ROI_SHADOW_CLOCK_ENABLED=false
SOLANA_ROI_SHADOW_CLOCK_SECONDS=1.0
SOLANA_ROI_PRICE_TRACKING_HORIZON_SECONDS=300
